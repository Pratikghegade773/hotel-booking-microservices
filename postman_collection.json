            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": {{room_id}},\n  \"checkInDate\": \"2026-11-01\",\n  \"checkOutDate\": \"2026-11-03\",\n  \"offerCode\": \"WELCOME10\"\n}"
