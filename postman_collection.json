{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-hotelbookingai",
    "name": "Hotel Booking AI - Microservices API",
    "description": "Ready-to-use step-by-step Postman collection for the Hotel Booking AI Microservices platform. Automatic token and ID propagation between requests.",
