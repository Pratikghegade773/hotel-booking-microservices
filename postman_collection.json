  "variable": [
    { "key": "base_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "owner_token", "value": "", "type": "string" },
    { "key": "customer_token", "value": "", "type": "string" },
    { "key": "hotel_id", "value": "1", "type": "string" },
    { "key": "room_id", "value": "1", "type": "string" },
